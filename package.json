  "scripts": {
    "start": "expo start --dev-client --localhost",
    "android": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=/Users/$USER/Library/Android/sdk ANDROID_SDK_ROOT=/Users/$USER/Library/Android/sdk expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npx expo-doctor",
    "release:check": "npm run check && npx expo export --platform android --output-dir work/release-android && npx expo export --platform web --output-dir work/release-web"
  },
  "private": true
