{
  "expo": {
    "name": "Pesa Plan",
    "slug": "pesa-plan",
    "scheme": "pesaplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pesa-plan-icon-v1.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jimkar.pesaplan"
    },
    "android": {
      "package": "com.jimkar.pesaplan",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F2D23",
        "foregroundImage": "./assets/pesa-plan-icon-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pesa Plan to unlock your private financial data."
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "ac278466-04d8-45f0-812e-048355df675a"
      }
    }
  }
}
