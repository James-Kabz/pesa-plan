{
  "expo": {
    "name": "Pesa Plan",
    "slug": "pesa-plan",
    "scheme": "pesaplan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pesa-plan-icon-v1.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jimkar.pesaplan"
    },
    "android": {
      "package": "com.jimkar.pesaplan",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0F2D23",
        "foregroundImage": "./assets/pesa-plan-icon-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pesa Plan to unlock your private financial data."
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
